class_name VersusArena
extends Resource
## A Versus arena (spec S-024, Q24, T-376): the part of a map where the
## fight takes place, its barriers, low walls, nailed doors and stairs up to
## the roofs (ArenaPiece), where everyone starts, and the navigation mesh of
## the map with those pieces in. One file per arena in data/arenas/,
## generated by tools/godot/build_versus_arena.gd; ArenaBuilder puts it in
## the map. To add an arena: docs/MODULES.md, "Le mode Versus".

## The map this arena belongs to (its scene path).
@export_file("*.scn", "*.tscn") var map_path := ""
## Inside the barriers, world x and z.
@export var bounds := Rect2()
@export var pieces: Array[ArenaPiece] = []
## Where the hunted start, side by side (Q29), facing hunted_yaw.
@export var hunted_spawns: PackedVector3Array = []
@export var hunted_yaw := 0.0
## Where the boss starts, about 60 m away (Q29), facing boss_yaw.
@export var boss_spawn := Vector3.ZERO
@export var boss_yaw := 0.0
## Chests of the arena (Q32): the first arena_chests at the start, then
## phase_chests more at each new phase of the boss, in this order (higher
## places later: the roof, the fire escape). Each hunted also gets its own
## first chest by its start.
@export var chest_spots: PackedVector3Array = []
## The map's navigation mesh baked with the pieces (closed doors, stairs).
@export var navigation_mesh: NavigationMesh
## The return terminals (T-414, ReturnTerminals), each screen facing the
## centre of the arena.
@export var terminal_spots: PackedVector3Array = []


## Whether point (world) is inside the barriers.
func contains(point: Vector3) -> bool:
	return bounds.has_point(Vector2(point.x, point.z))


## Where the n-th hunted starts.
func hunted_spawn(n: int) -> Vector3:
	if hunted_spawns.is_empty():
		return Vector3.ZERO
	return hunted_spawns[n % hunted_spawns.size()]


## The rotation.y of the n-th terminal: its screen towards the centre.
func terminal_yaw(n: int) -> float:
	var centre := bounds.get_center()
	var spot := terminal_spots[n]
	var toward := Vector2(centre.x - spot.x, centre.y - spot.z)
	return atan2(toward.x, toward.y)
