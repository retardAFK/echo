class_name PlaceholderSounds
extends RefCounted
## Placeholder sounds generated by code (spec S-003, Q5): no audio file in the
## build. Real sounds come in phase 10.

const MIX_RATE := 22050
const STEP_LENGTH := 0.14
const STEP_CUTOFF := 0.08
const BREATH_LENGTH := 0.7
const BREATH_CUTOFF := 0.25
const PEAK := 0.9
const ALARM_LENGTH := 0.8
const ALARM_LOW_HZ := 620.0
const ALARM_HIGH_HZ := 880.0
const ALARM_VOLUME := 0.5
const CALL_LENGTH := 0.6
const CALL_HIGH_HZ := 520.0
const CALL_LOW_HZ := 360.0
const CALL_VOLUME := 0.35
const RESCUE_LENGTH := 0.5
const RESCUE_CUTOFF := 0.15
const KEYS_LENGTH := 0.6
const KEYS_COUNT := 5
const KEY_LENGTH := 0.025
const BEEP_LENGTH := 0.3
const BEEP_HZ := 1040.0
const BEEP_VOLUME := 0.35
const DISK_LENGTH := 0.5
const DISK_CUTOFF := 0.6


## A dull thump: low-passed noise with a fast decay.
static func step() -> AudioStreamWAV:
	return _noise_burst(STEP_LENGTH, STEP_CUTOFF, false, 11)


## A breath: brighter noise that swells then fades.
static func breath() -> AudioStreamWAV:
	return _noise_burst(BREATH_LENGTH, BREATH_CUTOFF, true, 23)


## A car alarm: two alternating square tones, one cycle per noise.
static func alarm() -> AudioStreamWAV:
	var count := int(ALARM_LENGTH * MIX_RATE)
	var data := PackedByteArray()
	data.resize(count * 2)
	var phase := 0.0
	for i in count:
		var t := float(i) / count
		phase += (ALARM_LOW_HZ if t < 0.5 else ALARM_HIGH_HZ) / MIX_RATE
		var sample := ALARM_VOLUME * (1.0 if fmod(phase, 1.0) < 0.5 else -1.0)
		data.encode_s16(i * 2, int(sample * 32767.0))
	return _stream(data)


## A call for help (S-010, T-107): a soft voice-like tone that falls.
static func call_for_help() -> AudioStreamWAV:
	var count := int(CALL_LENGTH * MIX_RATE)
	var data := PackedByteArray()
	data.resize(count * 2)
	var phase := 0.0
	for i in count:
		var t := float(i) / count
		phase += lerpf(CALL_HIGH_HZ, CALL_LOW_HZ, t) / MIX_RATE
		var sample := CALL_VOLUME * sin(TAU * phase) * sin(PI * t)
		data.encode_s16(i * 2, int(sample * 32767.0))
	return _stream(data)


## A rescue: the rustle of a struggle.
static func rescue() -> AudioStreamWAV:
	return _noise_burst(RESCUE_LENGTH, RESCUE_CUTOFF, true, 37)


## Keys clacking on an old keyboard (S-018): a few short bright clicks.
static func keys() -> AudioStreamWAV:
	var rng := RandomNumberGenerator.new()
	rng.seed = 53
	var count := int(KEYS_LENGTH * MIX_RATE)
	var data := PackedByteArray()
	data.resize(count * 2)
	var click := int(KEY_LENGTH * MIX_RATE)
	for k in KEYS_COUNT:
		var start := int(rng.randf_range(0.0, KEYS_LENGTH - KEY_LENGTH) * MIX_RATE)
		for i in click:
			var t := float(i) / click
			var sample := rng.randf_range(-1.0, 1.0) * pow(1.0 - t, 4.0) * PEAK * 0.6
			data.encode_s16((start + i) * 2, int(sample * 32767.0))
	return _stream(data)


## A wrong code (S-018, T-266): a short square beep.
static func beep() -> AudioStreamWAV:
	var count := int(BEEP_LENGTH * MIX_RATE)
	var data := PackedByteArray()
	data.resize(count * 2)
	for i in count:
		var phase := fmod(float(i) * BEEP_HZ / MIX_RATE, 1.0)
		var sample := BEEP_VOLUME * (1.0 if phase < 0.5 else -1.0)
		data.encode_s16(i * 2, int(sample * 32767.0))
	return _stream(data)


## A hard disk scratching while it downloads (S-018, T-266): bright noise.
static func disk() -> AudioStreamWAV:
	return _noise_burst(DISK_LENGTH, DISK_CUTOFF, true, 71)


static func _noise_burst(
	length: float, smoothing: float, swell: bool, p_seed: int
) -> AudioStreamWAV:
	var rng := RandomNumberGenerator.new()
	rng.seed = p_seed
	var count := int(length * MIX_RATE)
	var data := PackedByteArray()
	data.resize(count * 2)
	var filtered := 0.0
	for i in count:
		var t := float(i) / count
		filtered = lerpf(filtered, rng.randf_range(-1.0, 1.0), smoothing)
		var envelope := sin(PI * t) if swell else pow(1.0 - t, 3.0)
		var sample := clampf(filtered * envelope * PEAK / smoothing * 0.25, -1.0, 1.0)
		data.encode_s16(i * 2, int(sample * 32767.0))
	return _stream(data)


static func _stream(data: PackedByteArray) -> AudioStreamWAV:
	var stream := AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.mix_rate = MIX_RATE
	stream.stereo = false
	stream.data = data
	return stream
