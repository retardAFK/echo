extends GutTest
## The cité des Tilleuls, generated by tools/godot/build_tilleuls.gd (spec S-006, T-039).

const MAP_SCENE := preload("res://game/maps/tilleuls/tilleuls.tscn")
const NAVMESH := preload("res://game/maps/tilleuls/tilleuls_navmesh.tres")
## Plan point (0, 0) is the north-west corner; the map center is the world origin.
const ORIGIN := Vector3(110, 0, 110)
const MAP_SIZE := 220.0
## Inside the fences: west fence, exit gate, noise wall, site fence (plan meters).
const FENCED := Rect2(6, 2.8, 204.5, 209.4)

var _map: GameMap


func before_each() -> void:
	_map = MAP_SCENE.instantiate()
	add_child_autofree(_map)


func after_each() -> void:
	GameSession.role = GameSession.Role.HUNTED


func _plan(point: Vector3) -> Vector2:
	return Vector2(point.x + ORIGIN.x, point.z + ORIGIN.z)


func _floor_height(plan: Vector2) -> Variant:
	var space := _map.get_world_3d().direct_space_state
	var from := Vector3(plan.x, 50, plan.y) - ORIGIN
	var query := PhysicsRayQueryParameters3D.create(from, from + Vector3.DOWN * 60, 1)
	var hit := space.intersect_ray(query)
	return null if hit.is_empty() else hit["position"].y


func test_start_menu_opens_the_cite() -> void:
	assert_eq(StartMenu.MAP_SCENE, MAP_SCENE.resource_path)


func test_ground_covers_the_whole_map() -> void:
	await wait_physics_frames(2)
	var step := 10.0
	var x := step / 2.0
	while x < MAP_SIZE:
		var y := step / 2.0
		while y < MAP_SIZE:
			var height: Variant = _floor_height(Vector2(x, y))
			assert_not_null(height, "ground at %s" % Vector2(x, y))
			y += step
		x += step


func test_hunted_starts_on_a_spawn_point() -> void:
	var points := _map.get_spawn_points()
	assert_gte(points.size(), 4)
	var player: Player = _map.get_node("Player")
	var nearest := INF
	for point in points:
		nearest = minf(nearest, point.distance_to(player.global_position))
	assert_lt(nearest, 0.01)
	await wait_physics_frames(30)
	assert_true(player.is_on_floor())


func test_spawn_points_are_far_from_the_monster() -> void:
	var monster: Monster = _map.get_node("Monster")
	assert_almost_eq(_plan(monster.global_position), Vector2(190, 190), Vector2.ONE * 0.01)
	for point in _map.get_spawn_points():
		assert_gt(point.distance_to(monster.global_position), 60.0)


func test_navigation_stays_inside_the_fences() -> void:
	var outside: Array[Vector2] = []
	for vertex in NAVMESH.get_vertices():
		var plan := _plan(vertex)
		if not FENCED.grow(0.5).has_point(plan):
			outside.append(plan)
	assert_eq(outside, [] as Array[Vector2], "the map is closed on all sides")


## Waits until the navigation server has merged the map's navigation mesh.
func _nav_map() -> RID:
	# The navigation map is shared by every test: wait until this map's mesh is
	# merged, that is until a spawn point lies on it.
	var nav_map := _map.get_world_3d().navigation_map
	var spawn: Vector3 = _map.get_spawn_points()[0]
	await wait_until(
		func() -> bool:
			var closest := NavigationServer3D.map_get_closest_point(nav_map, spawn)
			return Vector2(closest.x, closest.z).distance_to(Vector2(spawn.x, spawn.z)) < 0.1,
		5
	)
	return nav_map


func test_every_spawn_point_is_on_the_navigation_mesh() -> void:
	var nav_map: RID = await _nav_map()
	for point in _map.get_spawn_points():
		var closest := NavigationServer3D.map_get_closest_point(nav_map, point)
		assert_lt(_plan(closest).distance_to(_plan(point)), 0.1, "spawn %s" % _plan(point))
		assert_lt(absf(closest.y - point.y), 1.0, "spawn %s" % _plan(point))


func test_exit_tunnel_is_closed_by_its_gate() -> void:
	await wait_physics_frames(2)
	var space := _map.get_world_3d().direct_space_state
	var from := Vector3(155, 1, 12) - ORIGIN
	var query := PhysicsRayQueryParameters3D.create(from, Vector3(155, 1, -5) - ORIGIN, 3)
	var hit := space.intersect_ray(query)
	assert_false(hit.is_empty())
	assert_almost_eq(_plan(hit["position"]).y, 3.2, 0.05)


func test_blocks_of_flats_are_walls() -> void:
	# They hide the hunted and muffle noise (S-002).
	for block in ["BarreA", "BarreB", "BarreC", "BarreD", "BarreE", "BarreF", "BarreG"]:
		var body: StaticBody3D = _map.get_node("Structures/%s/Walls" % block)
		assert_eq(body.collision_layer, NoiseBus.WALLS_COLLISION_MASK, block)


func test_monster_role_starts_the_prey_on_a_spawn_point() -> void:
	GameSession.role = GameSession.Role.MONSTER
	var map: GameMap = MAP_SCENE.instantiate()
	add_child_autofree(map)
	assert_not_null(map.prey)
	var nearest := INF
	for point in map.get_spawn_points():
		nearest = minf(nearest, point.distance_to(map.prey.global_position))
	assert_lt(nearest, 0.01)
