; Engine configuration file.
; Godot 4: open this project with the latest stable Godot 4 release (4.7 at setup).
; The editor will rewrite this file on first save; keep the Compatibility renderer.

config_version=5

[application]

config/name="Écho"
run/main_scene="res://game/ui/start_menu.tscn"
run/flush_stdout_on_print.dedicated_server=true
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

NoiseBus="*res://game/autoload/noise_bus.gd"
NetSession="*res://game/net/net_session.gd"

[display]

; Constitution 2.2: 640 x 360 internal resolution, scaled up with sharp pixels
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

